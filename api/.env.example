# =============================================================================
# Variáveis de ambiente da API do Corpus
# -----------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha com os dados da sua máquina:
#
#     copy .env.example .env        (Windows)
#     cp   .env.example .env        (Linux / macOS)
#
# O arquivo `.env` NÃO deve ser versionado no Git — ele guarda a senha do banco.
# Por isso existe o `.gitignore` nesta pasta.
# =============================================================================

# Porta em que a API vai escutar
PORT=3000

# ---- Conexão com o MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_do_mysql_aqui
DB_NAME=db_treino_seguro

# ---- CORS ----
# Origens autorizadas a chamar a API, separadas por vírgula.
# Em desenvolvimento, é a origem de onde o front-end é servido.
# Deixe vazio para liberar qualquer origem (use APENAS em desenvolvimento).
CORS_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,http://localhost:5500

# Custo do hash de senha (bcrypt). 10 é o padrão recomendado.
BCRYPT_ROUNDS=10
